{
  "manifest_version": 2,
  "version": "0.10",
  "name": "dgaylo-dark-theme",
  "theme": {
    "colors": {
      "frame": "rgb(32, 32, 32)",
      "frame_inactive": "rgb(32, 32, 32)",

      "ntp_background": "rgb(60, 60, 60)",
      "ntp_card_background": "rgb(32, 32, 32)",
      "ntp_text": "rgb(200, 200, 200)",

      "popup": "rgb(32, 32, 32)",
      "popup_border": "rgba(32, 32, 32, 0.5)",
      "popup_highlight": "rgba(0, 120, 255, 0.5)",
      "popup_highlight_text": "rgb(200, 200, 200)",
      "popup_text": "rgb(200, 200, 200)",

      "sidebar": "rgb(60, 60, 60)",
      "sidebar_highlight": "rgba(0, 120, 255, 0.5)",
      "sidebar_highlight_text": "rgb(200, 200, 200)",
      "sidebar_text": "rgb(200, 200, 200)",

      "tab_selected": "rgb(60, 60, 60)",
      "tab_text": "rgb(200, 200, 200)",
      "tab_background_text": "rgb(200, 200, 200)",
      "tab_line": "rgba(0, 0, 0, 0.0)",
      "tab_loading": "rgba(0, 0, 0, 0.5)",
      
      "toolbar": "rgb(60, 60, 60)",
      "toolbar_field": "rgb(32, 32, 32)",
      "toolbar_field_border": "rgba(0, 0, 0, 0)",
      "toolbar_field_border_focus": "rgba(0, 0, 0, 0)",
      "toolbar_field_highlight": "rgba(0, 120, 255, 0.5)",
      "toolbar_field_text": "rgb(200, 200, 200)",
      "toolbar_text": "rgb(200, 200, 200)",
      "toolbar_vertical_separator": "rgb(32, 32, 32)",
      "toolbar_bottom_separator": "rgb(32, 32, 32)",

      "icons": "rgb(200, 200, 200)",
      "icons_attention": "rgb(90, 140, 190)"
    },
    "properties": {
      "color_scheme": "dark"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dark-theme@dgaylo.com",
      "update_url": "https://dark-theme.dgaylo.com/updates.json"
    }
  }
}